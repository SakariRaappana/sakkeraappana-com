---
import type { CollectionEntry } from 'astro:content';

interface Props {
  seikkailu: CollectionEntry<'seikkailut'>;
}

const { seikkailu } = Astro.props;
const { nimi, paikka, vuosi, kesto, km, vuodenaika, tiivistelma, kaynnissa, kuva } = seikkailu.data;
---

<a href={`/seikkailut/${seikkailu.slug}`} class:list={['adventure-card', { 'is-live': kaynnissa }]}>
  <div class="adventure-card-image">
    {kuva
      ? <img class="adventure-card-img" src={kuva} alt={nimi} />
      : <div class="adventure-card-placeholder img-placeholder" aria-hidden="true"></div>}
    <div class="adventure-card-overlay"></div>
    {kaynnissa && <span class="tag-live adventure-card-live">Käynnissä</span>}
  </div>
  <div class="adventure-card-body">
    <div class="adventure-card-meta t-label">
      <span>{vuosi} · {paikka}</span>
    </div>
    <h3 class="t-heading-3 adventure-card-title">{nimi}</h3>
    <p class="t-body-sm adventure-card-summary">{tiivistelma}</p>
    {(km || kesto || vuodenaika) && (
      <p class="adventure-card-stats t-mono">
        {[km && `${km} KM`, kesto, vuodenaika && vuodenaika.toUpperCase()].filter(Boolean).join(' · ')}
      </p>
    )}
  </div>
</a>

<style>
.adventure-card {
  display: block;
  background: var(--color-surface);
  overflow: hidden;
  transition: background 0.4s var(--ease-out);
}

.adventure-card:hover {
  background: var(--color-surface-2);
}

.adventure-card-image {
  position: relative;
  overflow: hidden;
}

.adventure-card-img {
  width: 100%;
  aspect-ratio: 16/10;
  object-fit: cover;
  display: block;
  transition: transform 0.7s var(--ease-out);
}

.adventure-card:hover .adventure-card-img {
  transform: scale(1.03);
}

.adventure-card-placeholder {
  width: 100%;
  aspect-ratio: 16/10;
  transition: transform 0.7s var(--ease-out);
}

.adventure-card:hover .adventure-card-placeholder {
  transform: scale(1.03);
}

.adventure-card-overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(
    to top,
    color-mix(in srgb, var(--color-bg) 70%, transparent) 0%,
    transparent 60%
  );
}

.adventure-card-live {
  position: absolute;
  top: var(--space-4);
  left: var(--space-4);
}

.adventure-card-body {
  padding: var(--space-8);
}

.adventure-card-meta {
  margin-bottom: var(--space-4);
}

.adventure-card-title {
  margin-bottom: var(--space-3);
  transition: color 0.25s;
}

.adventure-card.is-live .adventure-card-title { color: var(--color-fire); }

.adventure-card:hover .adventure-card-title {
  color: var(--color-glacier);
}

.adventure-card.is-live:hover .adventure-card-title { color: var(--color-fire); }

.adventure-card-summary {
  display: -webkit-box;
  -webkit-line-clamp: 2;
  line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  margin-bottom: var(--space-6);
}

.adventure-card-stats {
  padding-top: var(--space-4);
  border-top: 1px solid var(--color-border);
  font-size: 0.78rem;
  letter-spacing: 0.08em;
  color: var(--color-glacier);
}
</style>
