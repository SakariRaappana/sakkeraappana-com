---
import Base from '@/layouts/Base.astro';
---

<Base
  title="Media — Sakke Raappana"
  description="Sakke Raappanan yleisöt, televisio- ja elokuvatuotannot sekä valikoidut uutisartikkelit, haastattelut ja mediaesiintymiset."
>

  <!-- ═══════════════════════════════════════════════
       HERO
       ═══════════════════════════════════════════════ -->
  <section class="media-hero">
    <img
      src="/kuvat/seikkailut/poyrisjarvi-selviytyminen/kuvat/Poyrisjarvi_4.jpg"
      alt="Retkikunta laajan maiseman reunalla"
      class="media-hero-img"
    />
    <div class="media-hero-overlay"></div>
    <div class="media-hero-content container">
      <p class="media-eyebrow t-label">Näkyvyys · Media</p>
      <h1 class="media-h1">Media</h1>
      <p class="media-standfirst">Tarinat, jotka ovat ylittäneet omien kanavien rajat.</p>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════
       INTRO
       ═══════════════════════════════════════════════ -->
  <section class="media-intro container">
    <p class="media-intro-lead">
      Sakke Raappanan seikkailut ovat tavoittaneet yleisöä pitkien dokumenttielokuvien, sosiaalisen median ja valtakunnallisen median kautta.
    </p>
    <p class="media-intro-body">
      Erämaavaellukset, selviytymishaasteet ja arktiset retkikunnat ovat herättäneet kiinnostusta myös uutistoimituksissa, radiossa, podcasteissa ja televisiotuotannoissa. Mediajulkisuus on tuonut tarinat sellaistenkin yleisöjen ulottuville, jotka eivät seuraa retkeilyä tai seikkailusisältöjä entuudestaan.
    </p>
  </section>

  <!-- ═══════════════════════════════════════════════
       ESIINTYNYT MEDIASSA — credibility wordmark strip
       ═══════════════════════════════════════════════ -->
  <section class="media-logos container">
    <p class="t-label media-logos-label">Esiintynyt mediassa</p>
    <div class="media-logos-strip">
      <a href="https://www.kauppalehti.fi/uutiset/a/3abde175-7fa0-42a0-ae84-73cd01ba257f" target="_blank" rel="noopener" class="logo-wordmark logo-kauppalehti">Kauppalehti</a>
      <a href="https://yle.fi/a/74-20149370" target="_blank" rel="noopener" class="logo-wordmark logo-yle">Yle</a>
      <a href="https://www.iltalehti.fi/kotimaa/a/9638025d-9034-48fa-b5d6-dcf4e66c411e" target="_blank" rel="noopener" class="logo-wordmark logo-iltalehti">Iltalehti</a>
      <a href="https://www.aamulehti.fi/ihmiset/art-2000012002066.html" target="_blank" rel="noopener" class="logo-wordmark logo-aamulehti">Aamulehti</a>
      <a href="https://www.lapinkansa.fi/pisin-eramainen-melontavaellus-pohjois-lapissa-sak/11413683" target="_blank" rel="noopener" class="logo-wordmark logo-lapinkansa">Lapin Kansa</a>
      <a href="https://www.maaseuduntulevaisuus.fi/metsa/a5954044-480f-4622-a5c5-59f5bbfa4e15" target="_blank" rel="noopener" class="logo-wordmark logo-maaseudun">Maaseudun Tulevaisuus</a>
      <span class="logo-wordmark logo-retkilehti">Retkilehti</span>
      <a href="https://areena.yle.fi/1-3436275" target="_blank" rel="noopener" class="logo-wordmark logo-areena">Yle Areena</a>
      <a href="https://areena.yle.fi/1-78114816" target="_blank" rel="noopener" class="logo-wordmark logo-radio">Yle Radio Suomi</a>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════
       PAINETUISSA LEHDISSÄ — leikearkisto
       ═══════════════════════════════════════════════ -->
  <section class="media-clippings container">
    <div class="section-label">
      <span class="t-label">Painetuissa lehdissä</span>
    </div>
    <p class="media-clippings-intro">Osa jutuista on julkaistu vain painettuna.</p>
    <div class="clippings-grid">
      <!-- Retki · Ilman suuntia — portrait, span 4 / row span 2 -->
      <div class="clip clip-a">
        <img
          src="/kuvat/media/leike-retki-ilman-suuntia.jpeg"
          alt="Retki – Ilman suuntia"
          class="clip-img"
        />
        <div class="clip-overlay"></div>
        <div class="clip-caption">
          <span class="clip-source">Retki · Elokuu 2023</span>
          <span class="clip-title">Ilman suuntia</span>
        </div>
      </div>
      <!-- Retki · Kanootti — landscape, span 8 -->
      <div class="clip clip-b">
        <img
          src="/kuvat/media/leike-retki-kanootti.jpeg"
          alt="Retki – Kanoottiseikkailu Kalmankaltiosta Jäämerelle"
          class="clip-img"
        />
        <div class="clip-overlay"></div>
        <div class="clip-caption">
          <span class="clip-source">Retki · Maaliskuu 2025</span>
          <span class="clip-title">Kanoottiseikkailu Kalmankaltiosta Jäämerelle</span>
        </div>
      </div>
      <!-- Aamulehti · Huippuvuoret — span 4 -->
      <div class="clip clip-c">
        <img
          src="/kuvat/media/leike-aamulehti-huippuvuoret.jpeg"
          alt="Aamulehti – Huippuvuorten huiputus"
          class="clip-img clip-img--left"
        />
        <div class="clip-overlay"></div>
        <div class="clip-caption">
          <span class="clip-source">Aamulehti · 2026</span>
          <span class="clip-title">Huippuvuorten huiputus</span>
        </div>
      </div>
      <!-- Keskisuomalainen · Teltta — span 4 -->
      <div class="clip clip-d">
        <img
          src="/kuvat/media/leike-keskisuomalainen-teltta.jpeg"
          alt="Keskisuomalainen – Teltan pystytys on naparetken kriittisin vaihe"
          class="clip-img clip-img--right"
        />
        <div class="clip-overlay"></div>
        <div class="clip-caption">
          <span class="clip-source">Keskisuomalainen · 2025</span>
          <span class="clip-title">Teltan pystytys on naparetken kriittisin vaihe</span>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════
       TELEVISIO JA ELOKUVAT
       ═══════════════════════════════════════════════ -->
  <section class="media-tv">
    <img
      src="/kuvat/seikkailut/poyrisjarvi-selviytyminen/kuvat/Poyrisjarvi_1.jpg"
      alt="Sakke ja retkikumppani"
      class="media-tv-bg"
    />
    <div class="media-tv-overlay"></div>
    <div class="media-tv-content container">
      <div class="section-label">
        <span class="t-label">Televisio ja elokuvat</span>
      </div>
      <div class="media-tv-inner">
        <span class="media-tv-badge">Erän&shy;kävi&shy;jät · Yle TV1 &amp; Yle Areena</span>
        <h2 class="media-tv-heading">
          Keskellä Vätsärin erä&shy;maata — ilman karttaa, ruokaa tai telttaa.
        </h2>
        <p class="media-tv-body">
          Erän­kävi­jät-sarjaa varten minut jätettiin vesitasolentokoneella keskelle Vätsärin erä­maata ilman karttaa, kompassia, ruokaa, telttaa tai makuupussia.
        </p>
        <div class="media-tv-premiere">
          <span class="media-tv-premiere-label">Televisioesitys</span>
          <span class="media-tv-premiere-date">Lokakuu 2026</span>
          <span class="media-tv-premiere-channel">Yle TV1 · 11. kausi</span>
        </div>
        <a
          href="https://areena.yle.fi/1-3436275"
          target="_blank"
          rel="noopener"
          class="btn btn-primary media-tv-cta"
        >
          Yle Areena →
        </a>
        <p class="media-tv-areena-note">Jaksot ilmestyvät Areenaan kauden alkaessa lokakuussa.</p>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════
       LEHDISTÖ JA RADIO — valikoidut nostot
       ═══════════════════════════════════════════════ -->
  <section class="media-press container">
    <div class="section-label">
      <span class="t-label">Lehdistö ja radio</span>
    </div>
    <h2 class="t-heading-2 media-press-heading">Valikoidut nostot</h2>

    <div class="press-grid">

      <!-- Kauppalehti 2026 — highlighted -->
      <a
        href="https://www.kauppalehti.fi/uutiset/a/3abde175-7fa0-42a0-ae84-73cd01ba257f"
        target="_blank"
        rel="noopener"
        class="press-card press-card--highlight"
      >
        <span class="press-outlet">Kauppalehti · 2026</span>
        <p class="press-title">He tekevät työkseen sitä, mistä moni vain haaveilee</p>
        <p class="press-desc">
          Suomeen on vaivihkaa muodostunut uudenlainen seikkailijoiden ammattikunta. Veteraanit, löytöretkeilijä Pata Degerman ja naparetkeilijä Poppis Suomela, vetävät perässään elantonsa seikkailuista kerääviä huimapäitä.
        </p>
        <span class="press-action">Lue juttu →</span>
      </a>

      <!-- Aamulehti 2026 — highlighted -->
      <a
        href="https://www.aamulehti.fi/ihmiset/art-2000012002066.html"
        target="_blank"
        rel="noopener"
        class="press-card press-card--highlight"
      >
        <span class="press-outlet">Aamulehti · 2026</span>
        <p class="press-title">Pirkanmaalainen retkeilijä lähti poikkeukselliselle matkalle, jonne otettiin jopa aseita jääkarhujen varalle</p>
        <p class="press-desc">
          Videoistaan tunnetun Sakke Raappanan retkikunta valmistautui Huippuvuorten jäätikköretkeen kaksi vuotta. Silti ratkaisevat hetket syntyivät asioista, joita ei voinut suunnitella.
        </p>
        <span class="press-action">Lue juttu →</span>
      </a>

      <!-- Yle 2025 — highlighted -->
      <a
        href="https://yle.fi/a/74-20149370"
        target="_blank"
        rel="noopener"
        class="press-card press-card--highlight"
      >
        <span class="press-outlet">Yle · 2025</span>
        <p class="press-title">Tubettaja Sakari Raappana puhui kasvissyönnin puolesta — nyt hän haluaa metsästää</p>
        <p class="press-desc">
          Retkeilyvideoistaan tunnettu pirkanmaalainen tubettaja Sakari Raappana oli 13 vuotta syömättä lihaa. Nuorempana hän teki vapaaehtoistyötä eläinoikeusjärjestöissä, mutta halusi vaikuttaa myös toisella tapaa lihansyönnin vähentämiseen.
        </p>
        <span class="press-action">Lue juttu →</span>
      </a>

      <!-- Yle Sápmi 2025 — highlighted -->
      <a
        href="https://yle.fi/a/74-20147628"
        target="_blank"
        rel="noopener"
        class="press-card press-card--highlight"
      >
        <div class="press-card-kicker">
          <span class="press-outlet">Yle Sápmi · 2025</span>
          <span class="press-badge press-badge--alt">Saamenkielinen</span>
        </div>
        <p class="press-title">Šaddoporrest miäcásteijen</p>
        <p class="press-desc">
          Sakari Raappana lii mađhâšâm Sáámán jo maŋgii, tastko putes luándučääsih já meccikuávluh eres ulmuittáá kiäsutteh suu.
        </p>
        <span class="press-action">Loga čállosa →</span>
      </a>

      <!-- Iltalehti — highlighted -->
      <a
        href="https://www.iltalehti.fi/kotimaa/a/9638025d-9034-48fa-b5d6-dcf4e66c411e"
        target="_blank"
        rel="noopener"
        class="press-card press-card--highlight"
      >
        <span class="press-outlet">Iltalehti</span>
        <p class="press-title">Sakari loi apuvälineen, jolla luonnossa voi suunnistaa ilman kompassia hätätilanteessa</p>
        <p class="press-desc">
          Apuvälineestä voi päätellä ilmansuunnan luonnossa ilman kompassia.
        </p>
        <span class="press-action">Lue juttu →</span>
      </a>

      <!-- Maaseudun Tulevaisuus — highlighted -->
      <a
        href="https://www.maaseuduntulevaisuus.fi/metsa/a5954044-480f-4622-a5c5-59f5bbfa4e15"
        target="_blank"
        rel="noopener"
        class="press-card press-card--highlight"
      >
        <span class="press-outlet">Maaseudun Tulevaisuus</span>
        <p class="press-title">Eläinsuojelijasta ja kasvissyöjästä kuoriutui metsästäjä – "Haluan tuoda keskusteluun muutakin kuin vastakkainasettelua"</p>
        <p class="press-desc">
          "Tunsin surua ja ahdistusta. Elämäni ensimmäisen riistalaukauksen jälkeinen adrenaliini oli alkanut laskea ja kaunis eläin makasi elottomana edessäni."
        </p>
        <span class="press-action">Lue juttu →</span>
      </a>

      <!-- Lapin Kansa — standard -->
      <a
        href="https://www.lapinkansa.fi/pisin-eramainen-melontavaellus-pohjois-lapissa-sak/11413683"
        target="_blank"
        rel="noopener"
        class="press-card"
      >
        <span class="press-outlet">Lapin Kansa · 2024</span>
        <p class="press-title">Melontavaellus Jäämerelle vain 13 päivässä</p>
        <p class="press-desc">
          "Menimme ihan limiteillä alusta loppuun", sanoo hurjan retken Petteri Veijosen kanssa tehnyt Sakke Raappana. Suorituksesta tekee käsittämättömän sen pitkä ja erämainen reitti, kuljettu matka ja käytetty aika.
        </p>
        <span class="press-action">Lue juttu →</span>
      </a>

      <!-- Retkilehti — no link -->
      <div class="press-card press-card--no-link">
        <span class="press-outlet">Retkilehti · Painettu</span>
        <p class="press-title">Useampi monen sivun artikkeli seikkailuista</p>
        <p class="press-desc">
          Suomen johtava retkeilymedia on julkaissut useamman laajan monisivuisen artikkelin Saken seikkailuista.
        </p>
        <span class="press-no-link">Ei verkkojulkaisua · Painettu juttu</span>
      </div>

    </div>
  </section>

  <!-- ═══════════════════════════════════════════════
       PODCAST — Metsä-Suomi / Yle Radio Suomi
       ═══════════════════════════════════════════════ -->
  <section class="media-podcast">
    <img
      src="/kuvat/media/radiossa.jpg"
      alt="Sakke Raappana radiostudiossa"
      class="media-podcast-bg"
    />
    <div class="media-podcast-overlay"></div>
    <div class="media-podcast-content container">
    <div class="section-label">
      <span class="t-label">Podcast</span>
    </div>
    <div class="podcast-inner">
      <div class="podcast-meta">
        <span class="podcast-source">Yle Radio Suomi · Metsä-Suomi</span>
        <h2 class="podcast-title">Uuden polven erätaitaja</h2>
        <p class="podcast-desc">
          Keskustelu selviytymisestä, erän­käynnistä ja siitä, kuinka perinteiset taidot, moderni retkeily ja dokumentaarinen tarinankerronta yhdistyvät. Jakso on kuunneltavissa suoraan tästä.
        </p>
      </div>
      <a
        href="https://areena.yle.fi/1-78114816"
        target="_blank"
        rel="noopener"
        class="podcast-player"
        aria-label="Kuuntele jakso Yle Areenassa"
      >
        <div class="podcast-waveform" aria-hidden="true">
          <span></span><span></span><span></span><span></span><span></span>
          <span></span><span></span><span></span><span></span><span></span>
          <span></span><span></span><span></span><span></span><span></span>
        </div>
        <div class="podcast-play-btn" aria-hidden="true">
          <svg width="28" height="28" viewBox="0 0 28 28" fill="none">
            <polygon points="9,5 23,14 9,23" fill="currentColor"/>
          </svg>
        </div>
        <div class="podcast-play-meta">
          <span class="podcast-play-label">Kuuntele Yle Areenassa</span>
          <span class="podcast-play-dur">Avautuu uudessa välilehdessä →</span>
        </div>
      </a>
    </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════
       ERÄMESSUT 2026 — EVENT FULL-BLEED
       ═══════════════════════════════════════════════ -->
  <div class="media-event-bleed">
    <img
      src="/kuvat/media/JUSSIJAUROLA_Eramessut2026_Perjantai-5.jpg"
      alt="Sakke Raappana Riihimäen Erämessuilla 2026"
      class="media-event-bleed-img"
    />
    <div class="media-event-bleed-overlay">
      <p class="media-event-bleed-label t-label">Tapahtuma</p>
      <h2 class="media-event-bleed-title">Riihimäen erämessut 2026</h2>
      <p class="media-event-bleed-caption">Haastateltavana Retkinikkarin lavalla</p>
    </div>
  </div>

  <!-- ═══════════════════════════════════════════════
       YLEISÖ OMISSA KANAVISSA
       ═══════════════════════════════════════════════ -->
  <section class="media-channels container">
    <div class="section-label">
      <span class="t-label">Yleisö omissa kanavissa</span>
    </div>
    <p class="media-channels-intro">
      Valtakunnallisen näkyvyyden rinnalla seikkailut tavoittavat vakiintuneen yleisön myös omissa kanavissa.
    </p>

    <div class="channels-grid">
      <a href="https://www.youtube.com/@sakkeraappana" target="_blank" rel="noopener" class="channel-card">
        <span class="channel-label">YouTube →</span>
        <div class="channel-stat">
          <span class="channel-number">16 700+</span>
          <span class="channel-unit">tilaajaa</span>
        </div>
        <div class="channel-stat channel-stat--secondary">
          <span class="channel-number channel-number--sm">2 milj.+</span>
          <span class="channel-unit">katselukertaa</span>
        </div>
      </a>
      <a href="https://www.instagram.com/sakkeraappana/" target="_blank" rel="noopener" class="channel-card">
        <span class="channel-label">Instagram →</span>
        <div class="channel-stat">
          <span class="channel-number">6 500+</span>
          <span class="channel-unit">seuraajaa</span>
        </div>
      </a>
      <a href="https://www.facebook.com/p/Sakke-Raappana-100064004742199/" target="_blank" rel="noopener" class="channel-card">
        <span class="channel-label">Facebook →</span>
        <div class="channel-stat">
          <span class="channel-number">4 400+</span>
          <span class="channel-unit">seuraajaa</span>
        </div>
      </a>
      <a href="https://www.tiktok.com/@sakkeraappana" target="_blank" rel="noopener" class="channel-card">
        <span class="channel-label">TikTok →</span>
        <div class="channel-stat">
          <span class="channel-number">2 700+</span>
          <span class="channel-unit">seuraajaa</span>
        </div>
      </a>
    </div>

    <div class="channels-footer">
      <p class="channels-note">
        Tarkemmat yleisö-, tavoittavuus- ja sisältökohtaiset tilastot ovat saatavilla erillisessä mediakortissa.
        <span class="channels-updated">· Luvut päivitetty 07 / 2026</span>
      </p>
      <a href="mailto:sakke.raappana@gmail.com?subject=Mediakortti" class="btn btn-primary">
        Pyydä mediakortti →
      </a>
    </div>
  </section>

</Base>

<style>
/* ═══════════════════════════════════════════════
   HERO
   ═══════════════════════════════════════════════ */
.media-hero {
  position: relative;
  min-height: 82vh;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  overflow: hidden;
}

.media-hero-img {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center 30%;
}

.media-hero-overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(
    180deg,
    rgba(14, 17, 19, 0.55) 0%,
    rgba(14, 17, 19, 0.2) 40%,
    rgba(14, 17, 19, 0.55) 70%,
    rgba(14, 17, 19, 0.97) 100%
  );
}

.media-hero-content {
  position: relative;
  z-index: 2;
  padding-bottom: var(--space-12);
  padding-top: calc(var(--nav-height) + var(--space-8));
  animation: mediaRise 1.1s var(--ease-out) both;
}

@keyframes mediaRise {
  from { opacity: 0; transform: translateY(20px); }
  to   { opacity: 1; transform: translateY(0); }
}

@media (prefers-reduced-motion: reduce) {
  .media-hero-content { animation: none; }
}

.media-eyebrow {
  color: var(--color-glacier);
  margin-bottom: 1.375rem;
}

.media-h1 {
  font-family: var(--font-display);
  font-size: clamp(3.25rem, 10vw, 9.375rem);
  font-weight: 800;
  line-height: 0.9;
  letter-spacing: -0.03em;
  color: #F3F1EA;
  hyphens: none;
}

.media-standfirst {
  font-family: var(--font-body);
  font-weight: 300;
  font-size: clamp(1.3125rem, 2.6vw, 1.875rem);
  line-height: 1.4;
  max-width: 42.5rem;
  margin-top: 1.75rem;
  color: #ECEAE3;
  text-wrap: balance;
}

/* ═══════════════════════════════════════════════
   INTRO
   ═══════════════════════════════════════════════ */
.media-intro {
  max-width: 820px;
  margin-inline: auto;
  padding-top: 6.25rem;
  padding-bottom: 1.875rem;
}

.media-intro-lead {
  font-family: var(--font-body);
  font-weight: 300;
  font-size: clamp(1.25rem, 1.5vw, 1.4375rem);
  line-height: 1.6;
  margin-bottom: 1.625rem;
  color: #ECEAE3;
}

.media-intro-body {
  font-family: var(--font-body);
  font-weight: 300;
  font-size: clamp(1.125rem, 1.3vw, 1.25rem);
  line-height: 1.62;
  color: #D9DAD8;
}

/* ═══════════════════════════════════════════════
   LOGOS STRIP
   ═══════════════════════════════════════════════ */
.media-logos {
  padding-top: 3.75rem;
  padding-bottom: 1.25rem;
}

.media-logos-label {
  text-align: center;
  margin-bottom: 1.875rem;
  color: var(--color-glacier);
}

.media-logos-strip {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: center;
  gap: 1.25rem 3.5rem;
  padding: 2.25rem 1.5rem;
  border-top: 1px solid rgba(255, 255, 255, 0.12);
  border-bottom: 1px solid rgba(255, 255, 255, 0.12);
}

.logo-wordmark {
  font-family: var(--font-display);
  color: #D9DAD8;
  hyphens: none;
  text-decoration: none;
