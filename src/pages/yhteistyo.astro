---
import Base from '@/layouts/Base.astro';

const useCases = [
  {
    numero: '01',
    otsikko: 'Brändi- ja sisältöyhteistyöt',
    kuvaus: [
      'Pitkäjänteisiä yhteistyöprojekteja, joissa brändi liittyy luontevasti osaksi seikkailua ja sen tarinaa.',
      'Yhteistyö voi sisältää esimerkiksi tuotteen käyttöä ja testaamista vaativissa olosuhteissa, dokumentaarista video- ja valokuvamateriaalia, sosiaalisen median sisältöjä, tuotekehitysyhteistyötä sekä näkyvyyttä elokuvissa ja tapahtumissa.',
      'Kumppanuuden ei tarvitse rajoittua retkeily- tai varustebrändeihin. Seikkailut tarjoavat kiinnostavan ympäristön myös teknologialle, liikenteelle, ravitsemukselle, rahoitukselle, vakuuttamiselle ja muille aloille, joiden arvoihin kuuluvat valmistautuminen, toimintakyky ja rohkeus edetä.',
    ],
  },
  {
    numero: '02',
    otsikko: 'Dokumentti- ja televisiotuotannot',
    kuvaus: [
      'Toimin tuotannoissa seikkailijana, esiintyjänä, erä- ja selviytymistaitojen asiantuntijana sekä kuvaavana tarinankertojana.',
      'Minulla on kokemusta pitkäkestoisten seikkailujen suunnittelusta ja dokumentoinnista olosuhteissa, joissa kuvaaminen on sovitettava turvallisuuden, sään ja fyysisen kuormituksen ehdoille.',
      'Yhteistyö voi olla valmis ohjelmaidea, yhteistuotanto, asiantuntijarooli tai osuus laajemmassa televisio- tai dokumenttituotannossa.',
    ],
  },
  {
    numero: '03',
    otsikko: 'Seikkailu- ja retkikuntaprojektit',
    kuvaus: [
      'Suunnittelen ja toteutan pitkäkestoisia seikkailuja pohjoisissa ja syrjäisissä ympäristöissä.',
      'Voin rakentaa uuden seikkailukonseptin yhdessä tuotantoyhtiön tai kumppanibrändin kanssa tai liittää yhteistyön osaksi jo suunnitteilla olevaa retkikuntaa.',
      'Hankkeisiin voi sisältyä reittitutkimusta, ryhmän kokoamista, logistiikkaa, turvallisuussuunnittelua, harjoittelua, kuvaamista ja monikanavaista julkaisua.',
    ],
  },
  {
    numero: '04',
    otsikko: 'Kuva- ja videotuotannot',
    kuvaus: [
      'Dokumentaarista valokuva- ja videosisältöä luonnossa, erämaassa ja vaativissa olosuhteissa.',
      'Tuotanto voidaan toteuttaa osana todellista seikkailua tai erillisenä kuvausprojektina. Teen tarvittaessa yhteistyötä muiden kuvaajien, elokuva-alan ammattilaisten, säveltäjien ja jälkituotantotiimien kanssa.',
      'Tavoitteena on materiaali, joka näyttää aidolta, koska se on syntynyt oikeassa ympäristössä.',
    ],
  },
  {
    numero: '05',
    otsikko: 'Media ja haastattelut',
    kuvaus: [
      'Olen käytettävissä haastatteluihin, asiantuntijakommentteihin ja mediaesiintymisiin, jotka liittyvät erämaihin, retkikuntiin, selviytymiseen, arktiseen retkeilyyn ja seikkailuelokuvien tekemiseen.',
      'Julkaisukelpoista valokuva- ja videomateriaalia voidaan toimittaa sovitun käyttötarkoituksen mukaan.',
    ],
  },
];

const phases = [
  {
    vaihe: 'Ennen retkeä',
    kuvaus: 'Valmistautuminen, harjoittelu, varustevalinnat ja projektin rakentaminen.',
  },
  {
    vaihe: 'Retken aikana',
    kuvaus: 'Aito käyttö, dokumentaariset tilanteet ja sisältö vaativista olosuhteista.',
  },
  {
    vaihe: 'Retken jälkeen',
    kuvaus: 'Elokuva, valokuvat, sosiaalisen median julkaisut, haastattelut ja tapahtumat.',
  },
];
---

<Base
  title="Yhteistyö — Sakke Raappana"
  description="Yhteistyötä Sakke Raappanan kanssa: dokumentti- ja televisiotuotannot, brändikumppanuudet, seikkailuprojektit, puheenvuorot sekä kuva- ja videosisällöt."
  theme="light"
>
  <!-- HERO -->
  <div class="page-hero">
    <img src="/kuvat/etusivu/hero-3.jpg" alt="Topografinen kartta punaisella reittiviivalla — seikkailun reittisuunnittelua" class="page-hero-img" />
    <div class="container">
      <p class="t-label" style="margin-bottom: 1.5rem;">Yhteistyö</p>
      <h1 class="t-display">Seikkailuja. Tarinoita.<br /><em>Yhteistyötä, jolla on<br />todellinen ympäristö.</em></h1>
    </div>
  </div>

  <div class="container">

    <!-- INTRO -->
    <section class="section intro-section">
      <p class="t-body intro-p">
        Teen yhteistyötä brändien, tuotantoyhtiöiden, medioiden ja tapahtumajärjestäjien kanssa. Rakennan sisältöjä ja hankkeita, joissa tuotteet, ihmiset ja tarinat ovat osa aitoa seikkailua – eivät irrallinen mainoskatko sen keskellä.
      </p>
      <p class="t-body intro-p">
        Parhaat yhteistyöt alkavat jo ennen lähtöä. Ne kulkevat mukana valmistautumisessa, varsinaisella retkellä ja myöhemmin syntyvissä elokuvissa, valokuvissa, sosiaalisen median sisällöissä ja tapahtumissa.
      </p>
    </section>

    <!-- KÄYTTÖTAPAUKSET -->
    <section class="section" aria-labelledby="usecases-heading">
      <div class="section-label">
        <span class="t-label" id="usecases-heading">Mitä voimme tehdä yhdessä?</span>
      </div>
      <div class="usecases-list">
        {useCases.map((item) => (
          <div class="usecase-item">
            <div class="usecase-header">
              <span class="usecase-number t-label">{item.numero}</span>
              <h2 class="usecase-title">{item.otsikko}</h2>
            </div>
            <div class="usecase-body">
              {item.kuvaus.map((p) => (
                <p class="t-body-sm">{p}</p>
              ))}
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- SISÄLTÖKAARI -->
    <section class="section content-arc-section" aria-labelledby="arc-heading" style="border-top: 1px solid var(--color-border);">
      <div class="section-label">
        <span class="t-label" id="arc-heading">Mitä yhteistyö voi tuottaa?</span>
      </div>
      <p class="arc-intro t-body" style="color: var(--color-muted); max-width: 52rem; margin-bottom: var(--space-12);">
        Yksi seikkailu voi muodostaa pitkän sisältökaaren:
      </p>
      <div class="arc-phases">
        {phases.map((phase) => (
          <div class="arc-phase">
            <p class="arc-phase-label t-label">{phase.vaihe}</p>
            <p class="t-body-sm">{phase.kuvaus}</p>
          </div>
        ))}
      </div>
      <p class="arc-footer t-body-sm" style="color: var(--color-muted); max-width: 52rem; margin-top: var(--space-12);">
        Kokonaisuus voidaan suunnitella kumppanin tavoitteiden mukaan. Yhteistyön sisältö, julkaisukanavat, käyttöoikeudet ja näkyvyys sovitaan aina selkeästi etukäteen.
      </p>
    </section>

    <!-- FILOSOFIA -->
    <section class="section philosophy-section" aria-labelledby="philosophy-heading" style="border-top: 1px solid var(--color-border);">
      <div class="philosophy-grid">
        <div class="philosophy-heading-col">
          <h2 class="t-heading-2" id="philosophy-heading">
            Aitoa käyttöä, ei päälle liimattua näkyvyyttä.
          </h2>
        </div>
        <div class="philosophy-body-col">
          <p class="t-body">
            En ota retkille mukaan tuotteita vain siksi, että ne näkyisivät kamerassa. Kumppanin täytyy sopia hankkeen luonteeseen, ja tuotteen on kestettävä myös todellinen käyttö.
          </p>
          <p class="t-body" style="margin-top: 1.25rem;">
            Tämä tekee yhteistyöstä uskottavaa. Kun varuste, palvelu tai brändi ratkaisee oikean ongelman, sen roolia ei tarvitse näytellä katsojalle.
          </p>
          <p class="t-body" style="margin-top: 1.25rem;">
            Esimerkiksi Arktinen taival -retkikuntaprojektissa yhteistyö <strong>Svala of Finlandin</strong> ja <strong>Poppamiehen</strong> kanssa alkoi jo valmistautumisen aikana. Kumppanit ovat olleet mukana harjoittelussa, tuotteiden käytössä, resepti- ja videosisällöissä sekä Huippuvuorten varsinaisella retkellä. Tarina jatkuu elokuvassa ja sen teatteriensi-illassa.
          </p>
        </div>
      </div>
    </section>

    <!-- REFERENSSI -->
    <section class="section reference-section" aria-labelledby="reference-heading" style="border-top: 1px solid var(--color-border);">
      <div class="section-label">
        <span class="t-label" id="reference-heading">Esimerkki yhteistyöstä</span>
      </div>
      <div class="reference-card">
        <div class="reference-header">
          <p class="t-label reference-partners">Svala of Finland &amp; Poppamies</p>
          <h2 class="t-heading-2 reference-title">Arktinen taival</h2>
        </div>
        <div class="reference-stats">
          <div class="reference-stat">
            <span class="data-value">2+</span>
            <span class="t-label reference-stat-label">vuotta rakentunut sisältökaari</span>
          </div>
          <div class="reference-stat">
            <span class="data-value">6</span>
            <span class="t-label reference-stat-label">osainen valmistautumissarja</span>
          </div>
          <div class="reference-stat">
            <span class="data-value">90 000+</span>
            <span class="t-label reference-stat-label">YouTube-katselua — pelkästä valmistautumisesta</span>
          </div>
        </div>
        <div class="reference-deliverables">
          <div class="reference-deliverable">
            <span class="t-label deliverable-label">Materiaali</span>
            <span class="t-body-sm">Kuva- ja videomateriaalia arktisista olosuhteista</span>
          </div>
          <div class="reference-deliverable">
            <span class="t-label deliverable-label">Elokuva</span>
            <span class="t-body-sm">Pitkä dokumenttielokuva</span>
          </div>
          <div class="reference-deliverable">
            <span class="t-label deliverable-label">Ensi-ilta</span>
            <span class="t-body-sm">Teatteriensi-ilta joulukuussa 2026</span>
          </div>
        </div>
      </div>
      <p class="reference-footnote t-body-sm">
        Yllä olevat luvut kertovat vasta valmistautumisvaiheesta. Elokuva — ja sen yleisö — on vasta tulossa.
      </p>
      <blockquote class="testimonial">
        <p class="testimonial-text t-body">"Arvostamme Saken tavassa toimia erityisesti aitoutta. Hän ei suosittele tuotteita kevyin perustein, vaan vasta silloin, kun ne ovat ansainneet paikkansa hänen varusteissaan ja seikkailuissaan. Sakke suhtautuu tekemiseensä tinkimättömästi ja testaa varusteet siellä, missä niiden suorituskyky todella punnitaan. Juuri tällainen yhteistyö on meille erittäin arvokasta."</p>
        <footer class="testimonial-footer">
          <span class="t-label testimonial-author">Henna Lauhasmaa</span>
          <span class="t-label testimonial-company">Svala of Finland</span>
        </footer>
      </blockquote>
    </section>

    <!-- YHTEYDENOTTO -->
    <section class="section contact-section" aria-labelledby="contact-heading" style="border-top: 1px solid var(--color-border);">
      <div class="section-label" style="margin-bottom: 2rem;">
        <span class="t-label" id="contact-heading">Ota yhteyttä</span>
      </div>
      <h2 class="t-heading-2" style="margin-bottom: 1.5rem;">
        Kerro projektista.
      </h2>
      <p class="t-body" style="color: var(--color-muted); max-width: 52rem;">
        Kerro lyhyesti tavoitteesta, aikataulusta ja siitä, millaista yhteistyötä olet ajatellut. Rakennetaan kokonaisuus, jossa seikkailu, tarina ja kumppanin tavoitteet tukevat toisiaan.
      </p>
      <div style="margin-top: 2rem;">
        <p class="t-label" style="margin-bottom: 0.75rem;">Sähköpostilla</p>
        <a href="mailto:sakke.raappana@gmail.com" class="contact-email">
          sakke.raappana@gmail.com
        </a>
      </div>
    </section>
  </div>
</Base>

<style>
.page-hero {
  position: relative;
  padding-top: calc(var(--nav-height) + var(--space-24));
  padding-bottom: var(--space-16);
  border-bottom: 1px solid var(--color-border);
  overflow: hidden;
}

.page-hero-img {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: 36% 20%;
}

.page-hero .container {
  position: relative;
}

/* Intro */
.intro-section {
  max-width: 52rem;
  border-bottom: none;
}

.intro-p + .intro-p {
  margin-top: 1.25rem;
}

/* Use cases — stacked list layout */
.usecases-list {
  display: flex;
  flex-direction: column;
  gap: 1px;
  background: var(--color-border);
}

.usecase-item {
  background: var(--color-bg);
  padding: var(--space-8) 0;
  display: grid;
  grid-template-columns: 280px 1fr;
  gap: var(--space-12);
  align-items: start;
}

.usecase-header {
  display: flex;
  flex-direction: column;
  gap: var(--space-3);
  padding-top: 0.15em;
}

.usecase-number {
  color: var(--color-glacier);
}

.usecase-title {
  font-family: var(--font-display);
  font-size: 1.25rem;
  font-weight: 700;
  letter-spacing: -0.01em;
  line-height: 1.2;
  color: var(--color-text);
}

.usecase-body {
  display: flex;
  flex-direction: column;
  gap: 0.875rem;
}

/* Content arc */
.arc-phases {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 1px;
  background: var(--color-border);
}

.arc-phase {
  background: var(--color-bg);
  padding: var(--space-8);
  display: flex;
  flex-direction: column;
  gap: var(--space-4);
}

.arc-phase-label {
  color: var(--color-glacier);
}

/* Philosophy */
.philosophy-grid {
  display: grid;
  grid-template-columns: 280px 1fr;
  gap: var(--space-12);
  align-items: start;
}

/* Reference case */
.reference-card {
  display: grid;
  grid-template-columns: 280px 1fr 1fr;
  gap: 1px;
  background: var(--color-border);
}

.reference-header,
.reference-stats,
.reference-deliverables {
  background: var(--color-bg);
  padding: var(--space-8);
}

.reference-partners {
  color: var(--color-glacier);
  margin-bottom: var(--space-3);
}

.reference-title {
  line-height: 1.15;
}

.reference-stats {
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  gap: var(--space-6);
}

.reference-stat {
  display: flex;
  flex-direction: column;
  gap: 0.25rem;
}

.data-value {
  font-family: var(--font-mono);
  font-size: 2rem;
  font-weight: 500;
  color: var(--color-text);
  letter-spacing: -0.02em;
  line-height: 1;
}

.reference-stat-label {
  color: var(--color-muted);
}

.reference-deliverables {
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  gap: var(--space-6);
}

.reference-deliverable {
  display: flex;
  flex-direction: column;
  gap: 0.25rem;
}

.deliverable-label {
  color: var(--color-glacier);
}

.reference-footnote {
  margin-top: var(--space-6);
  color: var(--color-muted);
  max-width: 52rem;
}

.testimonial {
  margin: var(--space-12) 0 0;
  padding: var(--space-8);
  border-left: 2px solid var(--color-glacier);
  max-width: 52rem;
}

.testimonial-text {
  font-style: italic;
  color: var(--color-text);
  margin: 0 0 var(--space-6);
}

.testimonial-footer {
  display: flex;
  flex-direction: column;
  gap: 0.25rem;
}

.testimonial-author {
  color: var(--color-text);
}

.testimonial-company {
  color: var(--color-muted);
}

/* Contact */
.contact-email {
  font-family: var(--font-body);
  font-size: 1.4rem;
  font-weight: 400;
  color: var(--color-text);
  transition: color 0.2s;
  word-break: break-all;
  overflow-wrap: break-word;
}

.contact-email:hover {
  color: var(--color-glacier);
}


@media (max-width: 1024px) {
  .usecase-item {
    grid-template-columns: 220px 1fr;
    gap: var(--space-8);
  }

  .philosophy-grid {
    grid-template-columns: 220px 1fr;
    gap: var(--space-8);
  }

  .reference-card {
    grid-template-columns: 1fr 1fr;
  }

  .reference-header {
    grid-column: 1 / -1;
  }
}

@media (max-width: 768px) {
  .usecase-item {
    grid-template-columns: 1fr;
    gap: var(--space-4);
  }

  .arc-phases {
    grid-template-columns: 1fr;
  }

  .philosophy-grid {
    grid-template-columns: 1fr;
    gap: var(--space-6);
  }

  .reference-card {
    grid-template-columns: 1fr;
  }

  .reference-header {
    grid-column: auto;
  }
}
</style>
