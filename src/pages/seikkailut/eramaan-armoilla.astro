---
import Base from '@/layouts/Base.astro';
import { getEntry } from 'astro:content';

const entry = await getEntry('seikkailut', 'eramaan-armoilla');
if (!entry) throw new Error('Seikkailua ei löydy');

const { nimi, paikka, vuosi, tiivistelma, kuva } = entry.data;

const IMG = '/kuvat/seikkailut/eramaan-armoilla/kuvat';
---

<Base title={`${nimi} — Sakke Raappana`} description={tiivistelma} image={kuva} ogType="article">

  <!-- ===== HERO ===== -->
  <section class="hero">
    <img class="hero-img" src={`${IMG}/EA_06_kavely.jpg`} alt="Sakke Raappana kävelee yksin Vätsärin erämaassa Lapissa" />
    <div class="hero-gradient"></div>
    <div class="hero-content container">
      <div class="hero-meta">
        <span class="hero-meta-tag">Eränkävijät · 11. kausi</span>
        <span class="hero-meta-line"></span>
        <span>{vuosi}</span>
        <span class="hero-meta-line"></span>
        <span class="hero-meta-place">{paikka}</span>
      </div>
      <h1 class="hero-title">{nimi}</h1>
      <p class="hero-lead">Yksin Vätsärissä ilman karttaa, kompassia, ruokaa tai suojaa.</p>
    </div>
  </section>

  <!-- ===== TEASER ===== -->
  <section class="teaser-section">
    <div class="teaser-content">
      <p>Olen yksi Eränkävijät-sarjan uusista päähenkilöistä. Syksyllä julkaistavalla kaudella nähdään vaatina selviytymisvaellus Vätsärin erämaassa — ilman telttaa, makuupussia, ruokaa, karttaa tai kompassia.</p>
      <p>Koko retken mahdollisti <a class="ntrnz-link" href="https://ntrnz.com/erankavijat-sarja-palaa-lokakuussa-uudella-11-kaudellaan/" target="_blank" rel="noopener">Ntrnz</a>, Eränkävijät-sarjan tuotantoyhtiö.</p>
      <p class="teaser-coming">Laajempi kuvaus seikkailusta tulossa pian!</p>
    </div>
  </section>

  <!-- ===== SEURAAVA ===== -->
  <section class="next-section container-wide">
    <a href="/seikkailut" class="next-card">
      <img src={`${IMG}/EA_08_ilmakuva.jpg`} alt="Ilmakuva Vätsärin erämaasta Lapissa" class="next-img" />
      <div class="next-overlay">
        <span class="chapter-label">Kaikki seikkailut →</span>
        <span class="next-title">Seikkailut</span>
      </div>
    </a>
  </section>

</Base>

<style>
.container-wide {
  max-width: var(--max-width);
  margin-inline: auto;
  padding-inline: var(--space-10);
}

/* ===== HERO ===== */
.hero {
  position: relative;
  height: 100vh;
  min-height: 640px;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  overflow: hidden;
}

.hero-img {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.hero-gradient {
  position: absolute;
  inset: 0;
  background: linear-gradient(
    180deg,
    rgba(14,17,19,0.55) 0%,
    rgba(14,17,19,0.12) 38%,
    rgba(14,17,19,0.35) 68%,
    rgba(14,17,19,0.96) 100%
  );
}

.hero-content {
  position: relative;
  z-index: 2;
  padding-bottom: var(--space-16);
}

.hero-meta {
  display: flex;
  align-items: center;
  gap: var(--space-4);
  font-family: var(--font-mono);
  font-size: 0.75rem;
  letter-spacing: 0.2em;
  text-transform: uppercase;
  color: var(--color-glacier);
  margin-bottom: var(--space-6);
}

.hero-meta-line {
  width: 26px;
  height: 1px;
  background: var(--color-glacier);
  opacity: 0.6;
}

.hero-meta-tag { color: var(--color-glacier); }
.hero-meta-place { color: var(--color-text); }

.hero-title {
  font-family: var(--font-display);
  font-weight: 800;
  font-size: clamp(3rem, 9vw, 7.5rem);
  line-height: 0.92;
  letter-spacing: -0.02em;
  margin: 0 0 var(--space-6);
  color: var(--color-text);
}

.hero-lead {
  font-family: var(--font-body);
  font-weight: 300;
  font-size: clamp(1.1rem, 2vw, 1.5rem);
  line-height: 1.4;
  color: var(--color-body);
  margin: 0;
  max-width: 42ch;
}

/* ===== TEASER ===== */
.teaser-section {
  max-width: 52rem;
  margin: 0 auto;
  padding: var(--space-32) var(--space-10) var(--space-24);
}

.teaser-content p {
  font-family: var(--font-body);
  font-weight: 300;
  font-size: clamp(1.15rem, 2vw, 1.4rem);
  line-height: 1.65;
  color: var(--color-body);
  margin: 0 0 var(--space-6);
}

.teaser-content strong {
  color: var(--color-text);
  font-weight: 600;
}

.teaser-content a.ntrnz-link {
  color: var(--color-text);
  font-weight: 600;
  text-decoration: underline;
  text-decoration-color: var(--color-glacier);
  text-underline-offset: 3px;
  transition: color 0.2s;
}

.teaser-content a.ntrnz-link:hover {
  color: var(--color-glacier);
}

.teaser-coming {
  font-family: var(--font-display);
  font-weight: 700;
  font-size: clamp(1.2rem, 2vw, 1.6rem);
  letter-spacing: -0.01em;
  color: var(--color-text);
  border-left: 3px solid var(--color-glacier);
  padding-left: var(--space-6);
  margin-top: var(--space-10) !important;
}

/* ===== SEURAAVA ===== */
.next-section {
  padding-bottom: var(--space-24);
}

.next-card {
  display: block;
  position: relative;
  overflow: hidden;
}

.next-img {
  width: 100%;
  height: 320px;
  object-fit: cover;
  opacity: 0.5;
  transition: opacity 0.4s var(--ease-out), transform 0.6s var(--ease-out);
}

.next-card:hover .next-img {
  opacity: 0.65;
  transform: scale(1.02);
}

.next-overlay {
  position: absolute;
  inset: 0;
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding: 0 var(--space-12);
  background: linear-gradient(90deg, rgba(14,17,19,0.85), rgba(14,17,19,0.35));
}

.chapter-label {
  font-family: var(--font-mono);
  font-size: 0.6875rem;
  letter-spacing: 0.16em;
  text-transform: uppercase;
  color: var(--color-glacier);
  margin-bottom: var(--space-2);
  display: block;
}

.next-title {
  display: block;
  font-family: var(--font-display);
  font-weight: 800;
  font-size: clamp(2rem, 4vw, 3.5rem);
  letter-spacing: -0.02em;
  color: var(--color-text);
  line-height: 1;
  margin-top: var(--space-4);
}
</style>
