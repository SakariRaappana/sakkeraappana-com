---
import Base from '@/layouts/Base.astro';
import { getEntry } from 'astro:content';

const entry = await getEntry('seikkailut', 'huippuvuoret-2026');
if (!entry) throw new Error('Seikkailua ei löydy');

const { nimi, paikka, vuosi, tiivistelma, kuva } = entry.data;

const IMG = '/kuvat/seikkailut/Huippuvuoret/Kuvat';
---

<Base title={`${nimi} — Sakke Raappana`} description={tiivistelma} image={kuva} ogType="article">

  <!-- ===== HERO ===== -->
  <section class="hero">
    <img class="hero-img" src={`${IMG}/hero-2.jpg`} alt="Arktinen taival – Huippuvuoret" />
    <div class="hero-gradient"></div>
    <div class="hero-content container">
      <div class="hero-meta">
        <span class="hero-meta-eyebrow">Arktinen retkikunta / Svalbard Expedition</span>
      </div>
      <h1 class="hero-title">Arktinen taival <span class="hero-title-coord">79°N</span></h1>
      <p class="hero-lead">Kuuden suomalaisen retkikunta Huippuvuorten jäätiköille. Tavoitteena saariston korkein huippu, Newtontoppen.</p>
    </div>
    <div class="hero-scroll">VIERITÄ ↓</div>
  </section>

  <!-- ===== FAKTAJUOVA ===== -->
  <section class="fact-strip">
    <div class="fact-grid container-wide">
      <div class="fact-cell">
        <dt>Kohde</dt>
        <dd>Huippuvuoret</dd>
      </div>
      <div class="fact-cell">
        <dt>Tavoite</dt>
        <dd>Newtontoppen</dd>
      </div>
      <div class="fact-cell">
        <dt>Kesto</dt>
        <dd>17 vuorokautta</dd>
      </div>
      <div class="fact-cell">
        <dt>Retkikunta</dt>
        <dd>6 henkilöä</dd>
      </div>
      <div class="fact-cell">
        <dt>Leveyspiiri</dt>
        <dd>79°N</dd>
      </div>
      <div class="fact-cell">
        <dt>Newtontoppen</dt>
        <dd>1 717 m mpy</dd>
      </div>
      <div class="fact-cell">
        <dt>Ahkion lähtöpaino</dt>
        <dd>100 kg</dd>
      </div>
      <div class="fact-cell">
        <dt>Elokuvan ensi-ilta</dt>
        <dd>Tampere · joulukuu 2026</dd>
      </div>
    </div>
  </section>

  <!-- ===== LEAD ===== -->
  <section class="lead-section">
    <p class="lead-text">Jokainen arktinen vuorokausi rakentui etenemisestä, yhteisistä toimintamalleista ja jatkuvasti muuttuvien olosuhteiden arvioinnista.</p>
  </section>

  <!-- ===== LUKU 01 — KOHTI HUIPPUVUORTEN KATTOA ===== -->
  <section class="chapter container-wide">
    <div class="chapter-image-left">
      <img src={`${IMG}/Huippuvuoret_hiihtoa.jpg`} alt="Hiihtoa Huippuvuorten jäätiköllä" />
    </div>
    <div class="chapter-text">
      <div class="chapter-label">01 — Kohti Huippuvuorten kattoa</div>
      <h2 class="chapter-title">Halusin rakentaa retkikunnan, jossa pitkä arktinen hiihtovaellus ja dokumentaarinen elokuvanteko yhdistyvät.</h2>
      <p>Kokosin kuusihenkisen ryhmän eri alojen osaajista ja johdin yli kaksi vuotta kestänyttä valmistautumista. Harjoittelimme fyysisen kunnon lisäksi jäätiköllä liikkumista köysistössä, railopelastusta, teltan myrskypystytystä, eräensiapua, tuliaseiden turvallista käsittelyä ja toimintaa jääkarhualueella.</p>
      <p>Keväällä 2026 olimme valmiita lähtemään kohti 79. leveyspiiriä.</p>
    </div>
  </section>

  <!-- ===== FULL-BLEED 1 ===== -->
  <figure class="full-bleed">
    <img src={`${IMG}/Huippuvuoret_teltat_vastavalo.jpg`} alt="Teltat vastavaloissa Huippuvuorten jäätiköllä" />
    <figcaption>79°N — Kodin ja turvapaikan yhdistelmä</figcaption>
  </figure>

  <!-- ===== LUKU 02 — VALKOINEN MAAILMA ===== -->
  <section class="chapter-02 container-wide">
    <div class="chapter-02-text">
      <div class="chapter-label">02 — Valkoinen maailma</div>
      <h2 class="chapter-title">Whiteout saattoi hävittää horisontin ja kaikki maanpinnan muodot.</h2>
      <p>Liikuimme suksilla ja kuljetimme varusteemme ahkioissa halki laajojen jäätiköiden. Päivät muodostuivat etenemisestä, leirin rakentamisesta ja jatkuvasti muuttuvien olosuhteiden arvioinnista.</p>
      <p>Railoriskin kasvaessa etenimme köysistössä, valmiina pysäyttämään mahdollisen putoamisen. Teltta oli kotimme ja turvapaikkamme. Ennen nousua yläjäätikölle ylläpidimme ympärivuorokautista jääkarhuvahtia — yksi valvoi muiden nukkuessa.</p>
    </div>
    <div class="chapter-02-images">
      <div class="ch02-img-main">
        <img src={`${IMG}/Huippuvuoret_jaatikko.jpg`} alt="Huippuvuorten jäätikkö" />
      </div>
      <div class="ch02-img-sm">
        <img src={`${IMG}/Huippuvuoret_Sakke_Raappana.jpg`} alt="Sakke Raappana Huippuvuorilla" />
      </div>
      <div class="ch02-img-sm">
        <img src={`${IMG}/Huippuvuoret_huipulla.jpg`} alt="Retkikunta huipulla" />
      </div>
    </div>
  </section>

  <!-- ===== FULL-BLEED 2 ===== -->
  <figure class="full-bleed">
    <img src={`${IMG}/hero-3.jpg`} alt="Arktinen maisema Huippuvuorilla" />
  </figure>

  <!-- ===== LUKU 03 — RETKIKUNTA ===== -->
  <section class="chapter-03 container-wide">
    <div class="chapter-03-sticky">
      <div class="chapter-label">03 — Retkikunta</div>
      <h2 class="chapter-title">Matka perustui tarkasti rakennettuun ryhmään ja siihen, että jokainen kantoi vastuuta muista myös väsyneenä.</h2>
      <div class="callout">
        <div class="callout-item">
          <span class="callout-num">6</span>
          <span class="callout-label">retkikunnan jäsentä</span>
        </div>
        <div class="callout-item">
          <span class="callout-num">17</span>
          <span class="callout-label">Vuorokautta</span>
        </div>
        <div class="callout-item">
          <span class="callout-num">79°</span>
          <span class="callout-label">Leveyspiiri</span>
        </div>
      </div>
    </div>
    <div class="chapter-03-body">
      <p>Arktinen taival ei ollut yksilösuoritus. Jokaisella retkikunnan jäsenellä oli oma vastuualueensa jäätikköturvallisuudesta ensiapuun, fyysiseen valmistautumiseen ja jääkarhuturvallisuuteen.</p>
      <blockquote class="pull-quote">Keskellä maisemaa, jossa ihminen ei ole ravintoketjun huipulla, ryhmän yhteinen toimintamalli on ainoa vakuutus.</blockquote>
      <p><a href="https://tuuliajo.fi/" target="_blank" rel="noopener">Samuli Raappana</a> toimi retkikunnan toisena kuvaajana ja stillkuvaajana. Yhdessä dokumentoimme matkan harjoittelusta Huippuvuorten jäätiköille — kaikki materiaali pitkää dokumenttielokuvaa varten.</p>
      <div class="ch03-images">
        <img src={`${IMG}/Huippuvuoret_hiihtoa.jpg`} alt="Hiihtoa jäätiköllä" />
        <img src={`${IMG}/Huippuvuoret_jaatikko.jpg`} alt="Jäätikkömaailma" />
      </div>
    </div>
  </section>

  <!-- ===== KUMPPANUUS ===== -->
  <section class="partners-section">
    <div class="container-wide">
      <div class="partners-top">
        <div class="partners-heading-block">
          <div class="chapter-label">Yhteistyö</div>
          <h2 class="partners-title">Kumppanuus<br>osana tarinaa.</h2>
        </div>
        <p class="partners-lead">Arktinen taival osoittaa, että vaikuttava yhteistyö voi alkaa kauan ennen varsinaista retkeä. Kumppaneille on syntynyt pitkäikäistä valokuva- ja videosisältöä, tuotetestausta todellisissa olosuhteissa sekä runsasta somenäkyvyyttä. Elokuva ja teatteriensi-ilta jatkavat samaa tarinaa joulukuussa 2026.</p>
      </div>
      <div class="partners-grid">
        <div class="partner-item">
          <div class="partner-logo-wrap">
            <img src={`${IMG}/svala_logo.png`} alt="Svala of Finland" class="partner-logo" />
          </div>
          <p class="partner-text">Svalan tuotteita käytettiin ja testattiin harjoitusvaelluksilla sekä Huippuvuorten arktisissa olosuhteissa. Yhteistyö rakentui tuotteiden todellisen käytön, pitkäaikaisen kokemuksen ja dokumentaarisen sisällön ympärille — ei pelkän näkyvyyden.</p>
        </div>
        <div class="partner-item">
          <div class="partner-logo-wrap">
            <img src={`${IMG}/poppamies_logo.png`} alt="Poppamies" class="partner-logo" />
          </div>
          <p class="partner-text">Poppamies oli mukana retkikunnan ruokien kehittämisessä. Yhteistyöstä syntyi reseptejä, tulisia makuhetkiä ja sisältöä, jossa tuotteet olivat luonteva osa retkikunnan valmistautumista ja päivittäistä elämää.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== CREDITS ===== -->
  <section class="credits-section">
    <div class="credits-grid container-wide">
      <div class="credit-cell">
        <dt>Retkikunnan johtaja ja elokuvantekijä</dt>
        <dd>Sakke Raappana</dd>
      </div>
      <div class="credit-cell">
        <dt>Toinen kuvaaja ja stillkuvat</dt>
        <dd>Samuli Raappana – <a href="https://tuuliajo.fi/" target="_blank" rel="noopener">Tuuliajo.fi</a></dd>
      </div>
      <div class="credit-cell">
        <dt>Alkuperäinen musiikki</dt>
        <dd>Peter Roe</dd>
      </div>
      <div class="credit-cell">
        <dt>Värimäärittely</dt>
        <dd>Mikko Suuronen · Agalma Films</dd>
      </div>
    </div>
    <p class="credits-photo container-wide">Kaikki artikkelin valokuvat: <a href="https://tuuliajo.fi/" target="_blank" rel="noopener">Samuli Raappana</a></p>
  </section>

  <!-- ===== ELOKUVA ===== -->
  <section class="film-section">
    <div class="container-wide">
      <div class="film-header">
        <div>
          <div class="chapter-label">Elokuva — Arktinen taival</div>
          <h2 class="film-title">Dokumenttielokuva retkikunnan<br>matkasta Newtontoppenille.</h2>
        </div>
        <p class="film-sub">Alkuperäisen soundtrackin on säveltänyt Peter Roe. Värimäärittely: Mikko Suuronen / Agalma Films.</p>
      </div>
      <div class="film-embed-wrap">
        <img src={`${IMG}/Huippuvuoret_huipulla.jpg`} alt="Arktinen taival — elokuva tulossa" class="film-poster-dim" />
        <div class="film-gradient"></div>
        <div class="film-premiere">
          <span class="film-premiere-label">Elokuvan ensi-ilta</span>
          <span class="film-premiere-date">Tampere · joulukuu 2026</span>
          <span class="film-premiere-cta">Elokuva julkaistaan joulukuussa 2026 →</span>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== VIDEOSARJA ===== -->
  <section class="series-section container-wide">
    <div class="section-header">
      <span class="t-label">Videosarja</span>
      <span class="section-line"></span>
      <span class="gallery-label">Valmistautumisen tarina</span>
    </div>
    <div class="series-intro-block">
      <p class="series-intro">Ennen varsinaista elokuvaa julkaistiin kuusi videota, jotka seuraavat retkikunnan valmistautumista — harjoituksista jääkarhuturvallisuuteen. Yhteistyökumppanit ovat luonteva osa tätä tarinaa.</p>
      <div class="series-stats">
        <div class="series-stat">
          <span class="series-stat-num">90 000+</span>
          <span class="series-stat-label">katselukertaa YouTubessa</span>
        </div>
        <div class="series-stat">
          <span class="series-stat-num">Tuhansia</span>
          <span class="series-stat-label">sivustokävijöitä <a href="https://www.arktinentaival.fi/" target="_blank" rel="noopener" class="series-stat-link">arktinentaival.fi</a>:ssä</span>
        </div>
      </div>
    </div>
    <div class="series-grid">
      <a href="https://youtu.be/oP2enE3SXCc" target="_blank" rel="noopener" class="series-card">
        <div class="series-thumb">
          <img src="https://img.youtube.com/vi/oP2enE3SXCc/mqdefault.jpg" alt="Arktinen taival — projektin esittely" />
          <div class="series-play-btn" aria-hidden="true"></div>
        </div>
        <div class="series-info">
          <span class="series-ep">Johdanto</span>
          <span class="series-title">Kanavan tulevaisuus — projektin esittely</span>
        </div>
      </a>
      <a href="https://www.youtube.com/watch?v=Xor6LcOOOfA" target="_blank" rel="noopener" class="series-card">
        <div class="series-thumb">
          <img src="https://img.youtube.com/vi/Xor6LcOOOfA/mqdefault.jpg" alt="Myrskyharjoitus" />
          <div class="series-play-btn" aria-hidden="true"></div>
        </div>
        <div class="series-info">
          <span class="series-ep">Osa 1</span>
          <span class="series-title">Myrskyharjoitus</span>
        </div>
      </a>
      <a href="https://www.youtube.com/watch?v=PQ54G9uludk" target="_blank" rel="noopener" class="series-card">
        <div class="series-thumb">
          <img src="https://img.youtube.com/vi/PQ54G9uludk/mqdefault.jpg" alt="Jääkarhuturvallisuus" />
          <div class="series-play-btn" aria-hidden="true"></div>
        </div>
        <div class="series-info">
          <span class="series-ep">Osa 2</span>
          <span class="series-title">Jääkarhuturvallisuus</span>
        </div>
      </a>
      <a href="https://www.youtube.com/watch?v=kfImK5xZLVk" target="_blank" rel="noopener" class="series-card">
        <div class="series-thumb">
          <img src="https://img.youtube.com/vi/kfImK5xZLVk/mqdefault.jpg" alt="Jäätikköharjoitus" />
          <div class="series-play-btn" aria-hidden="true"></div>
        </div>
        <div class="series-info">
          <span class="series-ep">Osa 3</span>
          <span class="series-title">Jäätikköharjoitus</span>
        </div>
      </a>
      <a href="https://www.youtube.com/watch?v=Zt3JHi4Yexk" target="_blank" rel="noopener" class="series-card">
        <div class="series-thumb">
          <img src="https://img.youtube.com/vi/Zt3JHi4Yexk/mqdefault.jpg" alt="Viimeinen harjoitus ennen Huippuvuoria" />
          <div class="series-play-btn" aria-hidden="true"></div>
        </div>
        <div class="series-info">
          <span class="series-ep">Osa 4</span>
          <span class="series-title">Viimeinen harjoitus ennen Huippuvuoria</span>
        </div>
      </a>
      <a href="https://www.youtube.com/watch?v=9OSXu2hi_UQ" target="_blank" rel="noopener" class="series-card">
        <div class="series-thumb">
          <img src="https://img.youtube.com/vi/9OSXu2hi_UQ/mqdefault.jpg" alt="Viimeinen video" />
          <div class="series-play-btn" aria-hidden="true"></div>
        </div>
        <div class="series-info">
          <span class="series-ep">Osa 5</span>
          <span class="series-title">Viimeinen video</span>
        </div>
      </a>
    </div>
  </section>

  <!-- ===== SEURAAVA ===== -->
  <section class="next-section container-wide">
    <a href="/seikkailut" class="next-card">
      <img src={`${IMG}/hero-3.jpg`} alt="" class="next-img" />
      <div class="next-overlay">
        <span class="chapter-label">Kaikki seikkailut →</span>
        <span class="next-title">Seikkailut</span>
      </div>
    </a>
  </section>

</Base>

<style>
/* ===== LAYOUT ===== */
.container-wide {
  max-width: var(--max-width);
  margin-inline: auto;
  padding-inline: var(--space-10);
}

/* ===== HERO ===== */
.hero {
  position: relative;
  height: 100vh;
  min-height: 640px;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  overflow: hidden;
}

.hero-img {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.hero-gradient {
  position: absolute;
  inset: 0;
  background: linear-gradient(
    180deg,
    rgba(14,17,19,0.55) 0%,
    rgba(14,17,19,0.12) 38%,
    rgba(14,17,19,0.35) 68%,
    rgba(14,17,19,0.96) 100%
  );
}

.hero-content {
  position: relative;
  z-index: 2;
  padding-bottom: var(--space-16);
}

.hero-meta {
  margin-bottom: var(--space-6);
}

.hero-meta-eyebrow {
  font-family: var(--font-mono);
  font-size: 0.75rem;
  letter-spacing: 0.2em;
  text-transform: uppercase;
  color: var(--color-glacier);
}

.hero-title {
  font-family: var(--font-display);
  font-weight: 800;
  font-size: clamp(3rem, 9vw, 7.5rem);
  line-height: 0.92;
  letter-spacing: -0.02em;
  margin: 0 0 var(--space-6);
  color: var(--color-text);
}

.hero-title-coord {
  font-size: 0.45em;
  font-weight: 400;
  letter-spacing: 0.04em;
  color: var(--color-glacier);
  vertical-align: middle;
  margin-left: 0.2em;
}

.hero-lead {
  font-family: var(--font-body);
  font-weight: 300;
  font-size: clamp(1.1rem, 2vw, 1.5rem);
  line-height: 1.4;
  color: var(--color-body);
  margin: 0;
  max-width: 42ch;
}

.hero-scroll {
  position: absolute;
  bottom: 1.5rem;
  left: 50%;
  transform: translateX(-50%);
  z-index: 2;
  font-family: var(--font-mono);
  font-size: 0.625rem;
  letter-spacing: 0.24em;
  color: var(--color-muted);
}

/* ===== FAKTAJUOVA ===== */
.fact-strip {
  border-bottom: 1px solid var(--color-border);
}

.fact-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
}

.fact-cell {
  padding: var(--space-8) var(--space-8);
  border-right: 1px solid var(--color-border);
  border-bottom: 1px solid var(--color-border);
}

.fact-cell:nth-child(4n) { border-right: none; }
.fact-cell:nth-last-child(-n+4) { border-bottom: none; }

.fact-cell dt {
  font-family: var(--font-mono);
  font-size: 0.65rem;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: var(--color-glacier);
  margin-bottom: var(--space-3);
}

.fact-cell dd {
  font-family: var(--font-display);
  font-weight: 700;
  font-size: clamp(1rem, 1.4vw, 1.4rem);
  color: var(--color-text);
  margin: 0;
}

/* ===== LEAD ===== */
.lead-section {
  max-width: 56rem;
  margin: 0 auto;
  padding: var(--space-32) var(--space-10);
  text-align: center;
}

.lead-text {
  font-family: var(--font-body);
  font-weight: 300;
  font-style: italic;
  font-size: clamp(1.4rem, 2.8vw, 2.2rem);
  line-height: 1.45;
  color: var(--color-text);
  margin: 0;
}

/* ===== LUKU 01 ===== */
.chapter {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: var(--space-16);
  align-items: center;
  padding-block: var(--space-10);
}

.chapter-image-left {
  aspect-ratio: 4/5;
  overflow: hidden;
}

.chapter-image-left img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: 70% center;
}

.chapter-label {
  font-family: var(--font-mono);
  font-size: 0.6875rem;
  letter-spacing: 0.16em;
  text-transform: uppercase;
  color: var(--color-glacier);
  margin-bottom: var(--space-4);
}

.chapter-title {
  font-family: var(--font-display);
  font-weight: 700;
  font-size: clamp(1.75rem, 3vw, 2.75rem);
  line-height: 1.05;
  letter-spacing: -0.015em;
  margin: 0 0 var(--space-6);
  color: var(--color-text);
}

.chapter-text p,
.chapter-02-text p,
.chapter-03-body p {
  font-family: var(--font-body);
  font-weight: 300;
  font-size: 1.2rem;
  line-height: 1.65;
  color: var(--color-body);
  margin: 0 0 var(--space-5);
}

/* ===== FULL-BLEED ===== */
.full-bleed {
  margin: var(--space-20) 0;
  position: relative;
}

.full-bleed img {
  width: 100%;
  height: 78vh;
  min-height: 460px;
  object-fit: cover;
}

.full-bleed figcaption {
  position: absolute;
  bottom: var(--space-6);
  left: var(--space-10);
  font-family: var(--font-mono);
  font-size: 0.6875rem;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: var(--color-text);
  background: rgba(14,17,19,0.55);
  backdrop-filter: blur(4px);
  padding: var(--space-2) var(--space-4);
}

/* ===== LUKU 02 ===== */
.chapter-02 {
  display: grid;
  grid-template-columns: 1fr 1.2fr;
  gap: var(--space-16);
  align-items: start;
  padding-block: var(--space-10);
}

.chapter-02-images {
  display: grid;
  grid-template-columns: 1.3fr 1fr;
  grid-template-rows: 1fr 1fr;
  gap: var(--space-3);
  height: 600px;
}

.ch02-img-main {
  grid-row: span 2;
  overflow: hidden;
}

.ch02-img-main img,
.ch02-img-sm img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.ch02-img-sm { overflow: hidden; }

/* ===== LUKU 03 ===== */
.chapter-03 {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: var(--space-16);
  align-items: start;
  padding-block: var(--space-10);
  overflow: clip;
}

.chapter-03-sticky {
  position: sticky;
  top: calc(var(--nav-height) + var(--space-8));
}

.callout {
  display: flex;
  gap: var(--space-8);
