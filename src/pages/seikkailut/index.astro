---
import Base from '@/layouts/Base.astro';
import { getCollection } from 'astro:content';

const seikkailut = await getCollection('seikkailut');
const sorted = seikkailut.sort((a, b) => b.data.vuosi - a.data.vuosi);

const currentYear = new Date().getFullYear();
const upcoming = sorted.filter(s => s.data.kaynnissa || s.data.vuosi >= currentYear);
const past = sorted.filter(s => !s.data.kaynnissa && s.data.vuosi < currentYear);
---

<Base
  title="Seikkailut — Sakke Raappana"
  description="Kaikki Sakke Raappanan merkittävät seikkailut ja retkikunnat arktisilta alueilta Suomen erämaahan."
>
  <div class="page-hero">
    <div class="container">
      <p class="t-label" style="margin-bottom: var(--space-6);">Seikkailut</p>
      <h1 class="t-display">Retkikunnat<br /><em>& projektit</em></h1>
      <p class="page-hero-sub t-body">
        Arktisista retkikunnista Suomen erämaihin – valikoidut seikkailut ja elokuvat.
      </p>
    </div>
  </div>

  <div class="container">
    {upcoming.length > 0 && (
      <section class="section" aria-labelledby="upcoming-heading">
        <div class="section-label">
          <span class="t-label" id="upcoming-heading">Tulossa &amp; käynnissä</span>
        </div>
        <div class="adventures-list">
          {upcoming.map(s => (
            <a href={`/seikkailut/${s.slug}`} class:list={['adventure-row', { 'is-live': s.data.kaynnissa }]}>
              {s.data.kuva
                ? <img class="adventure-row-thumb" src={s.data.kuva} alt={s.data.nimi} />
                : <div class="adventure-row-thumb img-placeholder" aria-hidden="true"></div>}
              <div class="adventure-row-info">
                {s.data.kaynnissa
                  ? <span class="tag-live">Käynnissä</span>
                  : <p class="t-label">{s.data.paikka} · {s.data.vuosi}</p>}
                <h2 class="t-heading-3 adventure-row-title">{s.data.nimi}</h2>
                <p class="t-body-sm">{s.data.tiivistelma}</p>
              </div>
              <div class="adventure-row-stats">
                {s.data.kesto && <span class="data-value">{s.data.kesto}</span>}
                {s.data.km && <span class="data-value">{s.data.km} KM</span>}
              </div>
              <div class="adventure-row-arrow" aria-hidden="true">→</div>
            </a>
          ))}
        </div>
      </section>
    )}

    <section class="section" aria-labelledby="past-heading">
      <div class="section-label">
        <span class="t-label" id="past-heading">Arkisto</span>
      </div>
      <div class="adventures-list">
        {past.map(s => (
          <a href={`/seikkailut/${s.slug}`} class="adventure-row">
            {s.data.kuva
              ? <img class="adventure-row-thumb" src={s.data.kuva} alt={s.data.nimi} />
              : <div class="adventure-row-thumb img-placeholder" aria-hidden="true"></div>}
            <div class="adventure-row-info">
              <p class="t-label">{s.data.paikka} · {s.data.vuosi}</p>
              <h2 class="t-heading-3 adventure-row-title">{s.data.nimi}</h2>
              <p class="t-body-sm">{s.data.tiivistelma}</p>
            </div>
            <div class="adventure-row-stats">
              {s.data.kesto && <span class="data-value">{s.data.kesto}</span>}
              {s.data.km && <span class="data-value">{s.data.km} KM</span>}
            </div>
            <div class="adventure-row-arrow" aria-hidden="true">→</div>
          </a>
        ))}
      </div>
    </section>
  </div>
</Base>

<style>
.page-hero {
  padding-top: calc(var(--nav-height) + var(--space-24));
  padding-bottom: var(--space-16);
  border-bottom: 1px solid var(--color-border);
}

.page-hero-sub {
  max-width: 600px;
  margin-top: var(--space-6);
}

.adventures-list {
  display: flex;
  flex-direction: column;
}

.adventure-row {
  display: grid;
  grid-template-columns: 140px 1fr auto 2rem;
  gap: var(--space-8);
  align-items: center;
  padding: var(--space-8) 0;
  border-bottom: 1px solid var(--color-border);
  transition: background 0.25s var(--ease-out), padding-inline 0.25s var(--ease-out);
}

.adventure-row:hover {
  background: var(--color-surface);
  padding-inline: var(--space-4);
  margin-inline: calc(-1 * var(--space-4));
}

.adventure-row-thumb {
  width: 140px;
  aspect-ratio: 4/3;
  flex-shrink: 0;
  object-fit: cover;
}

.adventure-row-title {
  margin-top: var(--space-2);
  margin-bottom: var(--space-3);
  transition: color 0.2s;
}

.adventure-row:hover .adventure-row-title {
  color: var(--color-glacier);
}

.adventure-row.is-live .adventure-row-title,
.adventure-row.is-live:hover .adventure-row-title {
  color: var(--color-fire);
}

.adventure-row-stats {
  display: flex;
  flex-direction: column;
  gap: var(--space-2);
  align-items: flex-end;
}

.adventure-row-stats .data-value {
  color: var(--color-glacier);
  white-space: nowrap;
}

.adventure-row-arrow {
  font-family: var(--font-mono);
  color: var(--color-muted);
  font-size: 1.2rem;
  transition: transform 0.2s, color 0.2s;
}

.adventure-row:hover .adventure-row-arrow {
  transform: translateX(4px);
  color: var(--color-glacier);
}

@media (max-width: 768px) {
  .adventure-row {
    grid-template-columns: 90px 1fr;
    grid-template-rows: auto auto;
  }

  .adventure-row-stats {
    display: none;
  }

  .adventure-row-arrow {
    display: none;
  }

  .adventure-row-info {
    grid-column: 2;
  }
}
</style>
