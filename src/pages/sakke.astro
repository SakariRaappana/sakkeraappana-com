---
import Base from '@/layouts/Base.astro';
---

<Base
  title="Sakke Raappana — Seikkailija ja elokuvantekijä"
  description="Kuka Sakke Raappana on — henkilötarina seikkailusta, eräosaamisesta ja dokumentaarisesta tarinankerronnasta."
  theme="light"
>
  <!-- HERO -->
  <div class="sakke-hero">
    <div class="container">
      <div class="sakke-hero-grid">
        <div class="sakke-hero-image">
          <div class="sakke-hero-placeholder img-placeholder" aria-hidden="true"></div>
        </div>
        <div class="sakke-hero-intro">
          <p class="t-label" style="margin-bottom: 1.5rem;">Sakke Raappana</p>
          <h1 class="t-heading-1">
            Seikkailija.<br />
            Elokuvantekijä.<br />
            <em>Pohjoinen.</em>
          </h1>
        </div>
      </div>
    </div>
  </div>

  <!-- BIO -->
  <div class="container">
    <div class="bio-section section">
      <div class="bio-text">
        <p class="t-body">
          Olen suomalainen seikkailija, eränkävijä ja dokumentaarinen sisällöntuottaja.
          Kotini on Pohjoinen — se on sekä maantieteellinen tosiasia että ajattelutapa.
          Haen ympäristöjä, jotka vaativat enemmän kuin mukavuusalue antaa.
        </p>
        <p class="t-body" style="margin-top: 1.5rem;">
          Ensimmäiset pitkät erämaaretket tein nuorena Lapissa. Ne opettivat jotain
          sellaista, mitä ei voi lukea kirjoista: miten selviytyy epävarmuudessa,
          miten rakennetaan suunnitelma joka pettää, ja miten siitä silti jatketaan.
          Siitä lähtien retket ovat kasvaneet — Norjan Finnmarkista Huippuvuorille,
          arktiselta rannikolta sisämaan erämaahan.
        </p>
        <p class="t-body" style="margin-top: 1.5rem;">
          Kamera on tullut mukaan alusta alkaen. Koska retkellä näkee asioita, joita
          haluaa myöhemmin muistella — mutta myös siksi, että tarina ansaitsee tulla
          kerrotuksi kunnolla. Dokumentaarinen elokuva ei ole somevideo, se on
          kärsivällisyyttä: kuvataan oikea valo, oikea hetki, oikea tunnelma.
        </p>
        <p class="t-body" style="margin-top: 1.5rem;">
          Taustaltani olen teknologian parissa toiminut ihminen — datan ja
          järjestelmien maailma ei ole vieras. Se näkyy tavassa suunnitella retkiä:
          huolellinen valmistelu, riskianalyysi, varautuminen. Mutta kun ollaan
          erämaassa, se kaikki haihtuu ja jäljelle jää vain se, mitä todella tietää.
        </p>
      </div>

      <aside class="bio-stats">
        <div class="bio-stat-group">
          <p class="t-label" style="margin-bottom: 1rem;">Luvuissa</p>
          <dl class="bio-stat-list">
            <div class="bio-stat-item">
              <dt class="bio-stat-number">340+</dt>
              <dd class="t-body-sm">Arktisia kilometrejä viimeisimmällä retkellä</dd>
            </div>
            <div class="bio-stat-item">
              <dt class="bio-stat-number">10+</dt>
              <dd class="t-body-sm">Merkittävää seikkailua dokumentoituna</dd>
            </div>
            <div class="bio-stat-item">
              <dt class="bio-stat-number">−30°C</dt>
              <dd class="t-body-sm">Huippuvuorten pakkaset pahimmillaan</dd>
            </div>
          </dl>
        </div>
      </aside>
    </div>

    <!-- OSAAMINEN -->
    <section class="section" aria-labelledby="skills-heading" style="border-top: 1px solid var(--color-border);">
      <div class="section-label">
        <span class="t-label" id="skills-heading">Osaaminen</span>
      </div>
      <div class="skills-grid">
        <div class="skill-item">
          <h3 class="skill-title">Arktinen erätaito</h3>
          <p class="t-body-sm">
            Navigointi, leiriytyminen, liikkuminen ääriolosuhteissa.
            Pohjoisten alueiden sää, maasto ja riskit.
          </p>
        </div>
        <div class="skill-item">
          <h3 class="skill-title">Selviytyminen</h3>
          <p class="t-body-sm">
            Pitkäkestoiset projektit minimaalisilla varusteilla.
            Ravinnon hankinta luonnosta, majoittuminen ilman telttaa.
          </p>
        </div>
        <div class="skill-item">
          <h3 class="skill-title">Dokumentaarinen kuvaus</h3>
          <p class="t-body-sm">
            Elokuvallinen kerronta ääriolosuhteissa.
            Kuvaaja, leikkaaja ja ohjaaja — yksi ihminen, yksi projekti.
          </p>
        </div>
        <div class="skill-item">
          <h3 class="skill-title">Projektisuunnittelu</h3>
          <p class="t-body-sm">
            Retkikuntien logistiikka, reittien tutkimus, riskienhallinta.
            Yhteistyöprojektit tuotantoyhtiöiden ja brändien kanssa.
          </p>
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="section cta-section" style="border-top: 1px solid var(--color-border);">
      <div class="cta-inner">
        <h2 class="t-heading-2">Yhteistyöstä kiinnostunut?</h2>
        <p class="t-body" style="color: var(--color-muted); margin-top: 1rem; max-width: 480px;">
          Olen avoin tuotannoille, brändiyhteistyöille, tapahtumille ja retkikuntaprojekteille.
        </p>
        <div style="display: flex; gap: 1rem; margin-top: 2rem; flex-wrap: wrap;">
          <a href="/yhteistyo" class="btn btn-primary">Yhteistyösivu</a>
          <a href="mailto:sakke@sakkeraappana.com" class="btn btn-ghost">Sähköposti</a>
        </div>
      </div>
    </section>
  </div>
</Base>

<style>
.sakke-hero {
  padding-top: calc(var(--nav-height) + var(--space-16));
  padding-bottom: var(--space-16);
  border-bottom: 1px solid var(--color-border);
}

.sakke-hero-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: var(--space-16);
  align-items: center;
}

.sakke-hero-placeholder {
  width: 100%;
  aspect-ratio: 3/4;
}

.sakke-hero-intro h1 {
  margin-top: var(--space-4);
}

/* Bio */
.bio-section {
  display: grid;
  grid-template-columns: 1fr 320px;
  gap: var(--space-16);
  align-items: start;
}

.bio-text p {
  color: var(--color-body);
}

.bio-stat-group {
  position: sticky;
  top: calc(var(--nav-height) + var(--space-8));
  padding: var(--space-8);
  background: var(--color-surface);
  border: 1px solid var(--color-border);
}

.bio-stat-list {
  display: flex;
  flex-direction: column;
  gap: var(--space-8);
}

.bio-stat-item {
  padding-bottom: var(--space-6);
  border-bottom: 1px solid var(--color-border);
}

.bio-stat-item:last-child {
  border-bottom: none;
  padding-bottom: 0;
}

.bio-stat-number {
  font-family: var(--font-mono);
  font-size: 1.9rem;
  font-weight: 500;
  letter-spacing: -0.01em;
  color: var(--color-glacier);
  margin-bottom: var(--space-2);
}

/* Skills */
.skills-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 1px;
  background: var(--color-border);
}

.skill-item {
  background: var(--color-bg);
  padding: var(--space-8);
}

.skill-title {
  font-family: var(--font-display);
  font-size: 1.35rem;
  font-weight: 700;
  letter-spacing: -0.01em;
  color: var(--color-text);
  margin-bottom: var(--space-3);
}

/* CTA */
.cta-section {}

@media (max-width: 900px) {
  .sakke-hero-grid {
    grid-template-columns: 1fr;
  }

  .bio-section {
    grid-template-columns: 1fr;
  }

  .bio-stat-group {
    position: static;
  }
}

@media (max-width: 640px) {
  .skills-grid {
    grid-template-columns: 1fr;
  }
}
</style>
